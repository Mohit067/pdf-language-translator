# ===================================================
# AI4Bharat IndicTrans2 Configuration
# GitHub: https://github.com/AI4Bharat/IndicTrans2
# NO API KEY NEEDED - translation runs 100% locally
# ===================================================

# Model selection: Hugging Face repo ids, or local directories containing the weights (fully offline).
# Empty = defaults. en->indic defaults to a public copy verified byte-identical to the official
# ai4bharat repo, pinned to the verified commit (no token needed).
INDICTRANS2_EN_INDIC_MODEL=
INDICTRANS2_EN_INDIC_REVISION=
INDICTRANS2_INDIC_EN_MODEL=ai4bharat/indictrans2-indic-en-dist-200M
INDICTRANS2_INDIC_INDIC_MODEL=ai4bharat/indictrans2-indic-indic-dist-320M

# The official ai4bharat repos are gated (auto-approved "Agree and access repository").
# After accepting, run `huggingface-cli login` once or set a read token here. Only used to download weights.
# HF_TOKEN=

# Inference tuning
TRANSLATION_BATCH_SIZE=8        # sentences per forward pass; lower it if memory is tight
TRANSLATION_NUM_BEAMS=4         # 1 = greedy decoding (fastest), 4-5 = best quality
TORCH_NUM_THREADS=0             # 0 = PyTorch default (all physical cores)
MAX_LOADED_MODELS=2             # least-recently-used models are unloaded beyond this
QUANTIZE_CPU_MODELS=0           # 1 = int8 dynamic quantization on CPU (faster, slightly lower quality)
# Models to load at startup instead of on first use (comma-separated: en-indic, indic-en, indic-indic).
# Keep comments on their own line when a value is empty: Docker would read the comment as the value.
PRELOAD_MODELS=en-indic

# Limits & retention
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=300
JOB_TTL_HOURS=24                # uploads/outputs older than this are deleted

# Backend Server Port
PORT=8000
